# Copy to .env (mode 0600). Do not commit .env.
# Used only by compose profile `sidecar`. The systemd hub mints its own token
# under ~/.mempalace/server/<palace-id>/token.
# Generate: python3 -c 'import secrets; print("MEMPALACE_MCP_HTTP_TOKEN="+secrets.token_urlsafe(32))'
MEMPALACE_MCP_HTTP_TOKEN=replace-with-long-random-secret
# Optional. Leave empty unless Qdrant auth is enabled.
MEMPALACE_QDRANT_API_KEY=
