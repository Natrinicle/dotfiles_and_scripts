# Copy to ${XDG_CONFIG_HOME:-$HOME/.config}/employer-parent-model/config.env
# Env-var NAMES and Vault path names only. Do not put API keys in this file.
# employer-parent-model --fetch-key writes secrets.env (mode 600) from Vault.

EMPLOYER_PARENT_MODEL=employer-claude
EMPLOYER_PARENT_OPUS_MODEL=employer-claude-opus
EMPLOYER_PARENT_KEY_ENV=EMPLOYER_ANTHROPIC_API_KEY
EMPLOYER_CLAUDE_MODEL=claude-sonnet-5-5
EMPLOYER_CLAUDE_OPUS_MODEL=claude-opus-5-5
EMPLOYER_CLAUDE_HAIKU_MODEL=claude-haiku-4-5-20251001
EMPLOYER_REPO_ROOTS="$HOME/repos/{company}:$HOME/repos/{company_alt}"
EMPLOYER_VAULT_ADDR=https://vault.{company_domain}
EMPLOYER_PARENT_KEY_VAULT_PATH=secret/{company}/anthropic
EMPLOYER_PARENT_KEY_VAULT_FIELD=api_key
