    yt-dlp -f bestvideo+bestaudio/best --compat-options multistreams \
      --extractor-args 'youtube:bypass_native_jsi' \
      --extractor-args 'youtubepot-bgutilhttp:base_url=http://127.0.0.1:4416' \
