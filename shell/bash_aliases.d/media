if cmds_exist ffmpeg; then
  _media_has_video() {
    local mime desc
    mime=$(file -b --mime-type -- "$1" 2>/dev/null || true)
    desc=$(file -b -- "$1" 2>/dev/null || true)
    case "$mime" in
      video/* | application/x-matroska | application/mxf | application/ogg)
        return 0
        ;;
    esac
    case "$desc" in
      *Matroska* | *WebM* | *ISO\ Media* | *MP4* | *AVI* | *MPEG*)
        return 0
        ;;
    esac
    ffprobe -v error -select_streams v:0 -show_entries stream=codec_type -of csv=p=0 -- "$1" 2>/dev/null | grep -qx video
  }

  _media_has_audio() {
    local mime desc
    mime=$(file -b --mime-type -- "$1" 2>/dev/null || true)
    desc=$(file -b -- "$1" 2>/dev/null || true)
    case "$mime" in
      audio/* | application/ogg)
        return 0
        ;;
    esac
    case "$desc" in
      *Audio* | *FLAC* | *WAVE* | *AIFF* | *Opus* | *MPEG\ ADTS*)
        return 0
        ;;
    esac
    ffprobe -v error -select_streams a:0 -show_entries stream=codec_type -of csv=p=0 -- "$1" 2>/dev/null | grep -qx audio
  }

  # convert_video — container/codec from the output name; probe input as video.
  # Usage: convert_video INPUT [OUTPUT]
  # Default OUTPUT is INPUT with .webm (VP9 + Opus, two-pass).
  convert_video() {
    local input="${1:-}"
    if [[ -z "$input" ]]; then
      echo "Usage: convert_video INPUT [OUTPUT]" >&2
      return 1
    fi
    if [[ ! -f "$input" ]]; then
      echo "'$input' is not a valid file" >&2
      return 1
    fi
    if ! _media_has_video "$input"; then
      echo "'$input' does not look like video (mime=$(file -b --mime-type -- "$input" 2>/dev/null || echo unknown))" >&2
      return 1
    fi
    local output="${2:-${input%.*}.webm}"
    if [[ "$output" == "$input" ]]; then
      output="${input}.webm"
    fi
    local ext="${output##*.}"
    ext="${ext,,}"
    case "$ext" in
      webm)
        ffmpeg -i "$input" -c:v libvpx-vp9 -pass 1 -b:v 0 -crf 21 -threads 8 -speed 4 \
          -tile-columns 6 -frame-parallel 1 -an -f webm -y /dev/null
        ffmpeg -i "$input" -c:v libvpx-vp9 -pass 2 -b:v 0 -crf 21 -threads 8 -speed 2 \
          -tile-columns 6 -frame-parallel 1 -auto-alt-ref 1 -lag-in-frames 25 \
          -c:a libopus -b:a 96k -f webm "$output"
        ;;
      mp4)
        ffmpeg -i "$input" -map 0 -c:v libx264 -crf 21 -preset medium \
          -c:a aac -b:a 192k -c:s mov_text "$output"
        ;;
      mkv)
        ffmpeg -i "$input" -map 0 -c:v libx264 -crf 21 -preset medium \
          -c:a aac -b:a 192k -c:s copy "$output"
        ;;
      *)
        echo "convert_video: unsupported output '.$ext' (use webm, mp4, or mkv)" >&2
        return 1
        ;;
    esac
  }

  convert_video_to_webm() {
    convert_video "$1" "${1%.*}.webm"
  }

  stabilize_video() {
    local filename="${1:-}"
    if [[ -z "$filename" ]]; then
      echo "Usage: stabilize_video FILE [shakiness [accuracy [smoothing]]]" >&2
      return 1
    fi
    if [[ ! -f "$filename" ]]; then
      echo "'$filename' is not a valid file" >&2
      return 1
    fi
    if ! _media_has_video "$filename"; then
      echo "'$filename' does not look like video (mime=$(file -b --mime-type -- "$filename" 2>/dev/null || echo unknown))" >&2
      return 1
    fi
    local stem ext base
    base="${filename##*/}"
    if [[ "$base" == *.* ]]; then
      stem="${filename%.*}"
      ext="${filename##*.}"
    else
      stem="$filename"
      ext="mkv"
    fi
    local shakiness="${2:-5}"
    local accuracy="${3:-15}"
    local smoothing="${4:-30}"

    ffmpeg -i "$filename" -vf "vidstabdetect=shakiness=${shakiness}:accuracy=${accuracy}" -f null -
    ffmpeg -i "$filename" -vf "vidstabtransform=smoothing=${smoothing}:input=transforms.trf" \
      "${stem}.stabilized.${ext}"
  }

  # convert_audio — probe audio MIME / streams; encoder from OUTPUT extension.
  # Usage: convert_audio INPUT [OUTPUT]
  # Default OUTPUT is INPUT with .mp3 at 320k.
  convert_audio() {
    local input="${1:-}"
    if [[ -z "$input" ]]; then
      echo "Usage: convert_audio INPUT [OUTPUT]" >&2
      return 1
    fi
    if [[ ! -f "$input" ]]; then
      echo "'$input' is not a valid file" >&2
      return 1
    fi
    if ! _media_has_audio "$input"; then
      echo "'$input' does not look like audio (mime=$(file -b --mime-type -- "$input" 2>/dev/null || echo unknown))" >&2
      return 1
    fi
    local output="${2:-${input%.*}.mp3}"
    if [[ "$output" == "$input" ]]; then
      output="${input}.mp3"
    fi
    local ext="${output##*.}"
    ext="${ext,,}"
    case "$ext" in
      mp3)
        ffmpeg -i "$input" -map 0:a:0 -b:a 320k -v 0 -f mp3 "$output"
        ;;
      ogg)
        ffmpeg -i "$input" -map 0:a:0 -c:a libvorbis "$output"
        ;;
      opus)
        ffmpeg -i "$input" -map 0:a:0 -c:a libopus -b:a 128k "$output"
        ;;
      wav)
        ffmpeg -i "$input" -map 0:a:0 -c:a pcm_s16le "$output"
        ;;
      flac)
        ffmpeg -i "$input" -map 0:a:0 -c:a flac "$output"
        ;;
      m4a | aac)
        ffmpeg -i "$input" -map 0:a:0 -c:a aac -b:a 256k "$output"
        ;;
      aiff | aif)
        ffmpeg -i "$input" -map 0:a:0 -c:a pcm_s16be "$output"
        ;;
      *)
        echo "convert_audio: unsupported output '.$ext'" >&2
        return 1
        ;;
    esac
  }

  convert_flac_to_mp3() {
    convert_audio "$1" "${1%.*}.mp3"
  }
fi

if cmds_exist mkvpropedit; then
  _is_matroska() {
    local f="$1" mime desc lower
    mime=$(file -b --mime-type -- "$f" 2>/dev/null || true)
    desc=$(file -b -- "$f" 2>/dev/null || true)
    lower="${f,,}"
    case "$mime" in
      video/x-matroska | application/x-matroska | video/webm | audio/webm | application/vnd.matroska)
        return 0
        ;;
    esac
    case "$desc" in
      *Matroska* | *WebM*)
        return 0
        ;;
    esac
    case "$lower" in
      *.mkv | *.mk3d | *.mka | *.webm)
        return 0
        ;;
    esac
    return 1
  }

  mkv_disable_subtitles() {
    local files=() f cand
    if [ "$#" -gt 0 ]; then
      files=("$@")
    else
      shopt -s nullglob
      for cand in *; do
        [[ -f "$cand" ]] || continue
        _is_matroska "$cand" && files+=("$cand")
      done
      shopt -u nullglob
    fi
    if [ "${#files[@]}" -eq 0 ]; then
      echo "mkv_disable_subtitles: no Matroska files" >&2
      return 1
    fi
    local rc=0
    for f in "${files[@]}"; do
      if [ ! -f "$f" ]; then
        echo "'$f' is not a valid file" >&2
        rc=1
        continue
      fi
      if ! _is_matroska "$f"; then
        echo "'$f' does not look like Matroska (mime=$(file -b --mime-type -- "$f" 2>/dev/null || echo unknown))" >&2
        rc=1
        continue
      fi
      mkvpropedit "$f" --edit track:s1 --set flag-default=0 --set flag-forced=0 || rc=1
    done
    return "$rc"
  }
fi

function kill_hung_vlc_instances() {
  vlc_instances_with_window=$(wmctrl -lp | grep [V]LC | awk '{print $3}' | tr -s '\n' '|' | tr -d '|$')
  vlc_instances_without_window=$(ps aux | grep [v]lc | awk '{print $2}' | grep -Pv "^${vlc_instances_with_window}$")
  if [ -n "${vlc_instances_without_window}" ]; then
    kill -9 ${vlc_instances_without_window}
  fi
}

