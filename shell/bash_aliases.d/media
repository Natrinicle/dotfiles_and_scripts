if cmds_exist exiftool; then
  _is_camera_raw() {
    local f="$1" mime desc lower
    mime=$(file -b --mime-type -- "$f" 2>/dev/null || true)
    desc=$(file -b -- "$f" 2>/dev/null || true)
    lower="${f,,}"
    case "$mime" in
      image/x-adobe-dng | image/x-canon-cr2 | image/x-canon-cr3 | image/x-nikon-nef | image/x-sony-arw | image/x-olympus-orf | image/x-panasonic-rw2 | image/x-fuji-raf | image/x-pentax-pef | image/x-raw | image/x-dcraw)
        return 0
        ;;
    esac
    case "$desc" in
      *DNG* | *CR2* | *CR3* | *NEF* | *ARW* | *ORF* | *RW2* | *RAF* | *PEF*)
        return 0
        ;;
    esac
    case "$lower" in
      *.dng | *.cr2 | *.cr3 | *.nef | *.arw | *.orf | *.rw2 | *.raf | *.pef | *.raw)
        return 0
        ;;
    esac
    return 1
  }

  # extract_preview_from_raw — pull the embedded JPEG from camera RAW.
  # Usage: extract_preview_from_raw [FILE...]
  # No args: every magic-detected RAW in the current directory.
  extract_preview_from_raw() {
    local files=() f out cand
    if [ "$#" -gt 0 ]; then
      files=("$@")
    else
      shopt -s nullglob
      for cand in *; do
        [[ -f "$cand" ]] || continue
        _is_camera_raw "$cand" && files+=("$cand")
      done
      shopt -u nullglob
    fi
    if [ "${#files[@]}" -eq 0 ]; then
      echo "extract_preview_from_raw: no RAW files" >&2
      return 1
    fi
    local rc=0
    for f in "${files[@]}"; do
      if [ ! -f "$f" ]; then
        echo "'$f' is not a valid file" >&2
        rc=1
        continue
      fi
      if ! _is_camera_raw "$f"; then
        echo "'$f' does not look like camera RAW (mime=$(file -b --mime-type -- "$f" 2>/dev/null || echo unknown))" >&2
        rc=1
        continue
      fi
      out="${f}.jpg"
      if exiftool -b -JpgFromRaw -- "$f" >"$out" 2>/dev/null && [ -s "$out" ]; then
        continue
      fi
      if exiftool -b -PreviewImage -- "$f" >"$out" 2>/dev/null && [ -s "$out" ]; then
        continue
      fi
      if exiftool -b -OtherImage -- "$f" >"$out" 2>/dev/null && [ -s "$out" ]; then
        continue
      fi
      rm -f -- "$out"
      echo "'$f' has no embedded JPEG preview" >&2
      rc=1
    done
    return "$rc"
  }

  extract-jpg-from-dngs() {
    extract_preview_from_raw "$@"
  }
fi

