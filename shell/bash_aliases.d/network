# route_port_to_host — DNAT a TCP port to a remote host, SNAT replies back.
# Prefers nftables (Debian current), falls back to iptables.
# Usage: route_port_to_host <portnum> <remote_host> <local_IP>
route_port_to_host() {
  local port="${1:-}"
  local remote_host="${2:-}"
  local local_host="${3:-}"
  if [[ -z ${port} || -z ${remote_host} || -z ${local_host} ]]; then
    echo "Usage: route_port_to_host <portnum> <remote_host> <local_IP>" >&2
    return 1
  fi

  local nftbin=""
  if command -v nft >/dev/null 2>&1; then
    nftbin=$(command -v nft)
  elif [ -x /usr/sbin/nft ]; then
    nftbin=/usr/sbin/nft
  elif [ -x /sbin/nft ]; then
    nftbin=/sbin/nft
  fi

  if [ -n "$nftbin" ]; then
    sudo "$nftbin" list table ip nat >/dev/null 2>&1 || sudo "$nftbin" add table ip nat
    sudo "$nftbin" list chain ip nat prerouting >/dev/null 2>&1 ||       sudo "$nftbin" add chain ip nat prerouting '{ type nat hook prerouting priority dstnat; policy accept; }'
    sudo "$nftbin" list chain ip nat postrouting >/dev/null 2>&1 ||       sudo "$nftbin" add chain ip nat postrouting '{ type nat hook postrouting priority srcnat; policy accept; }'
    sudo "$nftbin" add rule ip nat prerouting tcp dport "$port" dnat to "${remote_host}:${port}"
    sudo "$nftbin" add rule ip nat postrouting ip daddr "$remote_host" tcp dport "$port" snat to "$local_host"
    return
  fi

  local iptbin=""
  if command -v iptables >/dev/null 2>&1; then
    iptbin=$(command -v iptables)
  elif [ -x /usr/sbin/iptables ]; then
    iptbin=/usr/sbin/iptables
  elif [ -x /sbin/iptables ]; then
    iptbin=/sbin/iptables
  fi
  if [ -z "$iptbin" ]; then
    echo "route_port_to_host: need nft or iptables" >&2
    return 1
  fi
  sudo "$iptbin" -t nat -A PREROUTING -p tcp --dport "${port}" -j DNAT --to-destination "${remote_host}:${port}"
  sudo "$iptbin" -t nat -A POSTROUTING -p tcp -d "${remote_host}" --dport "${port}" -j SNAT --to-source "${local_host}"
}

curl_override_dns () {
    url="${1}"
    override_ip="${2}"
    if echo "${url}" | grep -q "https://"; then
      port="${3:-443}"
      hostname="$(echo "${url}" | grep -Po "(?<=https://)[^/]+" )"
    else
      port="${3:-80}"
      hostname="$(echo "${url}" | grep -Po "(?<=http://)[^/]+" )"
    fi
    curl "${url}" --resolve "${hostname}:${port}:${override_ip}"
}

