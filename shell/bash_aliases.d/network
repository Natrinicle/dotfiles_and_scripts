if cmds_exist curl; then
  function test_redirect () {
    local port domain
    if [[ $(echo "$2" | cut -d":" -f1) == "https" ]]; then
      port=443
    else
      port=80
    fi
    domain=$(echo "$2" | cut -d"/" -f3)
    echo "Testing $2 against $1:$port"

    curl --resolve "${domain}:${port}:$1" "$2" --progress-bar --insecure -sL -w "%{http_code} %{url_effective}\\n" -o /dev/null
  }
fi

# Show CN, SANs, and expiry for a TLS certificate.
# Usage: getcertnames [--starttls PROTO] [scheme://]HOST[:PORT]
# Ports 25/587 → smtp STARTTLS, 143 → imap, 110 → pop3, 21 → ftp.
# SNI is always sent. Default port is 443.
getcertnames() {
  if [ -z "${1:-}" ]; then
    echo "ERROR: No domain specified." >&2
    return 1
  fi

  local starttls="" host="" port="" spec
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --starttls)
        if [ -z "${2:-}" ]; then
          echo "Usage: getcertnames [--starttls PROTO] [scheme://]HOST[:PORT]" >&2
          return 2
        fi
        starttls="$2"
        shift 2
        ;;
      -p | --port)
        if [ -z "${2:-}" ]; then
          echo "Usage: getcertnames [--starttls PROTO] [scheme://]HOST[:PORT]" >&2
          return 2
        fi
        port="$2"
        shift 2
        ;;
      --)
        shift
        break
        ;;
      -*)
        echo "Usage: getcertnames [--starttls PROTO] [scheme://]HOST[:PORT]" >&2
        return 2
        ;;
      *)
        break
        ;;
    esac
  done

  spec="${1:-}"
  spec="${spec#https://}"
  spec="${spec#http://}"
  spec="${spec#ssl://}"
  spec="${spec#tls://}"
  spec="${spec%%/*}"

  if [[ "$spec" == \[*\]* ]]; then
    host="${spec#\[}"
    host="${host%%]*}"
    local rest="${spec#*\]}"
    if [[ "$rest" == :* ]]; then
      port="${port:-${rest#:}}"
    fi
  elif [[ "$spec" == *:* ]]; then
    host="${spec%%:*}"
    port="${port:-${spec#*:}}"
  else
    host="$spec"
  fi

  if [ -z "$host" ]; then
    echo "ERROR: No domain specified." >&2
    return 1
  fi
  port="${port:-443}"

  if [ -z "$starttls" ]; then
    case "$port" in
      25 | 587) starttls=smtp ;;
      143) starttls=imap ;;
      110) starttls=pop3 ;;
      21) starttls=ftp ;;
    esac
  fi

  echo "Testing ${host}:${port}${starttls:+ (STARTTLS $starttls)}…"
  echo ""

  local args=(-connect "${host}:${port}" -servername "${host}")
  if [ -n "$starttls" ]; then
    args+=(-starttls "$starttls")
  fi

  local tmp
  tmp=$(echo | openssl s_client "${args[@]}" 2>&1)

  if [[ "${tmp}" != *"-----BEGIN CERTIFICATE-----"* ]]; then
    echo "ERROR: Certificate not found." >&2
    printf '%s\n' "${tmp}" | grep -Ei 'error|connect|errno|unable' | tail -n 5 >&2
    return 1
  fi

  local cert
  cert=$(printf '%s\n' "${tmp}" | openssl x509 -noout -subject -ext subjectAltName -dates 2>/dev/null)

  echo "Common Name:"
  echo ""
  printf '%s\n' "${cert}" | awk -F'subject=' '
    /^subject=/ {
      s=$2
      if (match(s, /CN[[:space:]]*=[[:space:]]*[^,/]+/)) {
        cn=substr(s, RSTART, RLENGTH)
        sub(/^CN[[:space:]]*=[[:space:]]*/, "", cn)
        print cn
      } else {
        print s
      }
    }'
  echo ""
  echo "Subject Alternative Name(s):"
  echo ""
  printf '%s\n' "${cert}" | awk '
    /X509v3 Subject Alternative Name/ {flag=1; next}
    flag && /DNS:|IP Address:/ {
      gsub(/[[:space:]]/, "")
      n=split($0, a, ",")
      for (i=1; i<=n; i++) {
        gsub(/^DNS:/, "", a[i])
        gsub(/^IPAddress:/, "", a[i])
        if (length(a[i])) print a[i]
      }
      flag=0
    }'
  echo ""
  echo "Validity:"
  echo ""
  printf '%s\n' "${cert}" | awk '/^not(Before|After)=/ {print}'
  local not_after epoch_exp now left
  not_after=$(printf '%s\n' "${cert}" | awk -F= '/^notAfter=/ {print substr($0, index($0,"=")+1)}')
  if [ -n "$not_after" ]; then
    epoch_exp=$(date -d "$not_after" +%s 2>/dev/null || true)
    now=$(date +%s)
    if [ -n "$epoch_exp" ]; then
      left=$(( (epoch_exp - now) / 86400 ))
      if [ "$left" -lt 0 ]; then
        echo "Expired $(( -left )) day(s) ago."
      else
        echo "Expires in ${left} day(s)."
      fi
    fi
  fi
  return 0
}
