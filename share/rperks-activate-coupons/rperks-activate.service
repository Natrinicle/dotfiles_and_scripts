[Unit]
Description=Activate RPerks digital coupons
After=network-online.target rperks-activate-install.service
Requires=rperks-activate-install.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/.local/bin/rperks-activate-coupons
# Graphical session bits if config.json has headless:false
Environment=DISPLAY=:0
Environment=XAUTHORITY=%h/.Xauthority
Environment=HOME=%h
ExecStart=/usr/bin/node %h/.local/bin/rperks-activate-coupons/run-rperks.mjs
TimeoutStartSec=15min
Nice=10

[Install]
WantedBy=default.target
