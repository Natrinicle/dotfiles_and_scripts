[Unit]
Description=MemPalace scope router (stdio/HTTP MCP fan-out)
After=mempalace-mcp-http.service

[Service]
Type=simple
ExecStart=%h/.local/bin/mempalace-router --http --host 127.0.0.1 --port 8766
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mempalace-router

Environment=PYTHONUNBUFFERED=1

NoNewPrivileges=true

[Install]
WantedBy=default.target
